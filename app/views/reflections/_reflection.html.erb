<div id="<%= dom_id reflection %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Date:</strong>
    <%= reflection.date %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Task volume:</strong>
    <%= reflection.task_volume %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Comment:</strong>
    <%= reflection.comment %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Ai feedback:</strong>
    <%= reflection.ai_feedback %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Ai suggested tasks:</strong>
    <%= reflection.ai_suggested_tasks %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Status:</strong>
    <%= reflection.status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= reflection.user_id %>
  </div>
</div>
