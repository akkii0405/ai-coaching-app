<div id="<%= dom_id goal %>" class="p-4 bg-white shadow rounded-lg mb-4 border border-gray-100">
  <h2 class="text-xl font-bold text-gray-800"><%= goal.title %></h2>
  <p class="text-sm text-gray-500 mt-1">🎯 期限: <%= goal.target_date %></p>

  <div class="mt-3">
    <% if goal.draft? %>
      <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs font-bold rounded border border-gray-200">下書き（未確定）</span>
    <% elsif goal.in_progress? %>
      <span class="px-2 py-1 bg-blue-100 text-blue-700 text-xs font-bold rounded border border-blue-200">🚀 進行中</span>
    <% elsif goal.completed? %>
      <span class="px-2 py-1 bg-green-100 text-green-700 text-xs font-bold rounded border border-green-200">✅ 達成済み</span>
    <% end %>
  </div>

  <div class="mt-4 text-right">
    <%= link_to "ロードマップの詳細を見る", goal, class: "text-blue-600 hover:underline text-sm font-bold" %>
  </div>
</div>