<% content_for :title, "設定中の目標 - GoalPilot AI" %>

<div class="min-h-screen w-full bg-[#eef1f4] text-slate-800">
  <header class="border-b border-[#7bb5ff] bg-[#0d1c2d] text-white">
    <div class="mx-auto flex max-w-[1500px] items-center justify-between px-6 py-4 md:px-8">
      <%= link_to dashboard_path, class: "flex items-center gap-3 text-white no-underline transition hover:opacity-90" do %>
        <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#1d7ef3] text-lg shadow-[0_10px_20px_rgba(29,126,243,0.45)]">✦</div>
        <div class="text-[28px] font-bold tracking-[-0.04em]">GoalPilot AI</div>
      <% end %>

      <nav class="hidden items-center gap-8 text-[14px] font-medium text-slate-200 md:flex">
        <%= link_to "ダッシュボード", dashboard_path, class: "text-slate-200 no-underline transition hover:text-white" %>
        <span class="rounded-full bg-white/10 px-3 py-1 font-semibold text-white">目標一覧</span>
        <%= link_to "カレンダー", tasks_path, class: "text-slate-200 no-underline transition hover:text-white" %>
        <%= link_to "振り返り", new_reflection_path, class: "text-slate-200 no-underline transition hover:text-white" %>
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-[1500px] px-5 py-8 md:px-8 md:py-10">
    <!-- 通知バナー -->
    <% if notice.present? %>
      <div class="mb-6 flex items-center justify-between rounded-[16px] border border-[#a7ddb4] bg-[#eefbf2] px-5 py-3.5 text-[15px] font-medium text-[#1a7f46] shadow-sm">
        <div class="flex items-center gap-2">
          <span>✓</span>
          <span><%= notice %></span>
        </div>
      </div>
    <% end %>

    <!-- 見出しエリア -->
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <div class="mb-2 inline-flex items-center rounded-full border border-[#9ed0ff] bg-[#dfeeff] px-3.5 py-1 text-[13px] font-semibold text-[#1d7ef3]">
          <span class="mr-1.5">✦</span>
          目標マネジメント & ロードマップ
        </div>
        <h1 class="text-[34px] font-bold tracking-[-0.04em] text-slate-900">
          設定中の目標一覧
        </h1>
        <p class="mt-1 text-[15px] text-slate-500">
          登録された目標の確認・進捗管理・編集や削除が行えます。
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <%= link_to dashboard_path, class: "inline-flex items-center gap-2 rounded-[14px] border border-[#dfe5eb] bg-white px-4 py-2.5 text-[14px] font-semibold text-slate-700 shadow-sm transition hover:bg-[#f8faff] hover:border-[#b7d3ff] no-underline" do %>
          <span>←</span>
          <span>ダッシュボード</span>
        <% end %>

        <%= link_to new_goal_path, class: "inline-flex items-center gap-2 rounded-[14px] bg-[#1d7ef3] px-4 py-2.5 text-[14px] font-bold text-white shadow-[0_8px_18px_rgba(29,126,243,0.25)] transition hover:bg-[#1769cf] no-underline" do %>
          <span>＋</span>
          <span>新しい目標を作成</span>
        <% end %>
      </div>
    </div>

    <!-- メインカードコンテナ -->
    <section class="rounded-[30px] border border-[#dde3ea] bg-[#f3f6f8] p-5 shadow-[0_24px_52px_rgba(17,24,39,0.06)] md:p-8">
      <div class="rounded-[22px] border border-[#dfe5eb] bg-white p-5 shadow-[inset_0_0_0_1px_rgba(255,255,255,0.4)] md:p-7">
        <div class="mb-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <h2 class="text-[22px] font-bold tracking-tight text-slate-800">
              登録目標
            </h2>
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[12px] font-semibold text-slate-600">
              <%= @goals.count %>件
            </span>
          </div>
        </div>

        <% if @goals.any? %>
          <div class="space-y-4">
            <% @goals.each do |goal| %>
              <div id="<%= dom_id goal %>" class="flex flex-col gap-4 rounded-2xl border border-[#dfe5eb] bg-white p-5 shadow-xs transition hover:border-[#b7d3ff] lg:flex-row lg:items-center lg:justify-between">
                <div class="space-y-2 min-w-0">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <% if goal.draft? %>
                      <span class="rounded-md border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-[12px] font-bold text-amber-700">下書き（未確定）</span>
                    <% elsif goal.in_progress? %>
                      <span class="rounded-md border border-[#a7ddb4] bg-[#eefbf2] px-2.5 py-0.5 text-[12px] font-bold text-[#1a7f46]">🚀 進行中</span>
                    <% elsif goal.completed? %>
                      <span class="rounded-md border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[12px] font-bold text-blue-700">✅ 達成済み</span>
                    <% end %>

                    <span class="text-[13px] text-slate-500 font-medium">
                      🎯 達成期限: <%= goal.target_date.present? ? goal.target_date.strftime("%Y年%-m月%-d日") : "未設定" %>
                    </span>
                  </div>

                  <h3 class="text-[20px] font-bold text-slate-900 leading-snug">
                    <%= goal.title %>
                  </h3>

                  <% if goal.ai_roadmap.present? && goal.ai_roadmap.is_a?(Hash) && goal.ai_roadmap["roadmap"].present? %>
                    <p class="text-[13px] text-slate-500 line-clamp-1">
                      🛤️ 全 <%= goal.ai_roadmap["roadmap"].count %> ステップのロードマップ策定済み
                    </p>
                  <% end %>
                </div>

                <!-- アクションボタン群 -->
                <div class="flex flex-wrap items-center gap-2.5 shrink-0 self-end lg:self-center">
                  <%= link_to goal_path(goal), class: "inline-flex items-center gap-1.5 rounded-xl bg-[#1d7ef3] px-4 py-2 text-[13px] font-bold text-white shadow-xs transition hover:bg-[#1769cf] no-underline" do %>
                    <span>🗺️</span>
                    <span>ロードマップ詳細</span>
                  <% end %>

                  <%= link_to edit_goal_path(goal), class: "inline-flex items-center gap-1.5 rounded-xl border border-[#dfe5eb] bg-white px-3.5 py-2 text-[13px] font-semibold text-slate-700 transition hover:bg-[#f8faff] hover:border-[#b7d3ff] no-underline" do %>
                    <span>✏️</span>
                    <span>編集</span>
                  <% end %>

                  <%= button_to goal, method: :delete, class: "inline-flex items-center gap-1.5 rounded-xl border border-red-200 bg-red-50 px-3.5 py-2 text-[13px] font-bold text-red-600 transition hover:bg-red-100 cursor-pointer", data: { turbo_confirm: "本当に「#{goal.title}」を削除しますか？\nこの操作は取り消せません。" } do %>
                    <span>🗑️</span>
                    <span>削除する</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="py-14 text-center text-slate-400">
            <div class="text-[36px]">🎯</div>
            <p class="mt-3 text-[16px] font-medium text-slate-600">設定されている目標はまだありません。</p>
            <p class="mt-1 text-[14px] text-slate-400">大きな目標を入力すると、AIが自動でロードマップを作成します。</p>
            <div class="mt-5">
              <%= link_to "最初の目標を作成する →", new_goal_path, class: "inline-block rounded-xl bg-[#1d7ef3] px-5 py-3 text-[14px] font-bold text-white shadow-sm hover:bg-[#1769cf] no-underline" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </main>
</div>
